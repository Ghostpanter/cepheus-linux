# Reference: <https://postmarketos.org/devicepkg>
maintainer="Alexey Minnekhanov <alexeymin@postmarketos.org>"
pkgname=device-xiaomi-cepheus
pkgdesc="Xiaomi Mi 9"
pkgver=7
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
# !fhs: live overlay installs the panel under /opt, helpers under
# /usr/local, and helpers under /usr/local (no operator keys in the published overlay).
options="!check !archcheck !fhs !strip"
depends="
	linux-postmarketos-qcom-sm8150
	bootmac
	mkbootimg
	postmarketos-base
	py3-pillow
	font-wqy-zenhei
	cifs-utils
	docker
	vsftpd
	wireguard-tools
"
makedepends="devicepkg-dev"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="deviceinfo kernel-cmdline.conf 90-bootmac-wifi.rules cepheus-live-overlay.tar"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/90-bootmac-wifi.rules -t "$pkgdir"/etc/udev/rules.d/

	# Bake in live-device fixes plus afternoon panel/kiosk/burn-in/file-share
	# work. Do not enable kiosk, samba, ftp, or wg-quick here.
	tar -C "$pkgdir" -xf "$srcdir"/cepheus-live-overlay.tar
	chmod 755 "$pkgdir"/usr/local/sbin/slpi-stop-fastrpc-storm.sh \
		"$pkgdir"/usr/local/sbin/cepheus-ath10k-board.sh \
		"$pkgdir"/usr/local/sbin/cepheus-screen \
		"$pkgdir"/usr/local/sbin/cepheus-init \
		"$pkgdir"/usr/local/sbin/wg-config \
		"$pkgdir"/usr/local/sbin/wg0-refresh-endpoint.sh \
		"$pkgdir"/usr/local/bin/screen \
		"$pkgdir"/usr/local/bin/wifi-connect \
		"$pkgdir"/etc/systemd/system-generators/cepheus-enable-fixes \
		"$pkgdir"/etc/NetworkManager/dispatcher.d/50-wg0-refresh
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -sf /etc/systemd/system/slpi-stop-fastrpc-storm.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/slpi-stop-fastrpc-storm.service
	ln -sf /etc/systemd/system/cepheus-ath10k-board.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/cepheus-ath10k-board.service
	ln -sf /etc/systemd/system/cepheus-screen-off.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/cepheus-screen-off.service
	ln -sf /etc/systemd/system/cepheus-panel.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/cepheus-panel.service
	# kiosk / samba / ftp / mounts / wg-quick stay present but not enabled
}

nonfree_firmware() {
	pkgdesc="Modem, DSP and WiFi firmware (used in place from the stock partitions)"
	depends="msm-firmware-loader qrtr tqftpserv rmtfs"
	mkdir "$subpkgdir"
}

