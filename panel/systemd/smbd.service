[Unit]
Description=Samba SMB/CIFS server (smbd)
After=network-online.target nmbd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/smbd --foreground --no-process-group
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
